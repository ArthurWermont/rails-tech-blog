<div class="shadow bg-light p-5 rounded">
  <div class="text-center mb-5">
    <h1><%= @post.title %></h1>
  
    <p class="text-muted">
      <Strong> Por <%= @post.author %></Strong><br>
      <%= l @post.created_at, format: :long %>
    </p>

  </div>

    <div class="p-5">
      <%= @post.body.gsub('\n', '<br>').html_safe %>
    </div>
  </div>

<div class="m-5">
  <div class="text-center">
    <h4>
      <p class="text-muted"><%= pluralize( @post.comments.count, "Comentário") %></p>
      <% if @post.comments.count.zero? %>
        <span class="badge badge-success">Seja o primeiro a comentar</span>
      <% end %>
      </h4>
  </div>

  <div class="shadow-sm m-3 bg-light p-3 rounded">
    <%= form_with model: @comment, local: true do |form| %>
      <%= form.hidden_field :post_id, value: @post.id %>
        <div class="mb-3">
          <%= form.label :author, class: "form-label" %>
          <%= form.text_field :author, class: "form-control", required: true %>
        </div>

      <div class="mb-3">
        <%= form.label :body, class: "form-label" %>
        <%= form.text_area :body, class: "form-control", required: true %>
      </div>

      <%= form.submit 'Enviar Comentário', class: "btn btn-primary",
        data: { disable_with: "Enviando..." } %>
    <% end %>
  </div>

  <% @comments.each do |comment| %>

      <div class="shadow-sm m-3 bg-light p-3 rounded">
        <div class="row">

          <div class="col">
            <p><strong><%= comment.author %></strong> disse:</p>
          </div>

          <div class="col text-end"> 
            <em
              data-bs-toggle="tooltip"
              data-bs-placement="top"
              title="<%= l comment.created_at, format: :long %>"
              >
                <%= time_ago_in_words(comment.created_at) %> atrás
            </em>
          </div>

        </div>

        <hr>

        <p><%= sanitize(comment.body.gsub('\n', '<br>').html_safe) %></p>
      </div>
    <% end %>
</div>



