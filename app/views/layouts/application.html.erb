<!DOCTYPE html>
<html>
  <head>
    <title>"Blog do Wermont"</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Blog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
  <div class="bg-primary text-white text-center mb-4 p-4">
    <%= link_to root_path, class: "text-white text-decoration-none" do %>
      <h1 class="display-4">Blog do Wermont</h1>
    <% end %>

      <p class="lead">Olá, aqui você encontra os melhores conteúdos sobre programação!</p>
    </div>
    <div class="container">
      <% flash.each do |type, message| %>
        <div class="alert alert-<%= type == 'alert' ? 'danger' : 'success' %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
      <% end %>

      <div class="row justify-content-end mb-3">
        <div class="col-md-5">
          <%= form_with url: search_posts_path,
              method: :get,
              local: true,
              class: "d-flex gap-2" do |form| %>

            <%= form.text_field :q,
                placeholder: "Pesquisar...",
                class: "form-control",
                required: true,
                value: params[:q] %>

            <%= form.submit "Busca",
                class: "btn btn-primary",
                data: { disable_with: "Buscando..." } %>

          <% end %>
        </div>
      </div>

      <%= yield %>
    </div>

    <footer class="bg-primary text-white text-center mt-5 p-4">
      Copyright &copy; Arthur Wermont <%= Date.current.year %>.
    </footer>
  </body>
</html>
